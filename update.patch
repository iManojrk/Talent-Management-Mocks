+let activeMenu;
+function openSuccessorMenu(anchor, person) {
+  closeSuccessorMenu();
+  const menu = document.createElement('div');
+  menu.className = 'successor-menu';
+  const options = [
+    { label: 'Assign Learning' },
+    { label: 'Edit Successor' },
+    { label: 'Remove Successor' },
+  ];
+  options.forEach(opt => {
+    const btn = document.createElement('button');
+    btn.type = 'button';
+    btn.textContent = opt.label;
+    btn.addEventListener('click', () => {
+      console.log(`${opt.label} -> ${person.name}`);
+      closeSuccessorMenu();
+    });
+    menu.appendChild(btn);
+  });
+  document.body.appendChild(menu);
+
+  const rect = anchor.getBoundingClientRect();
+  requestAnimationFrame(() => {
+    menu.style.top = `${rect.bottom + window.scrollY + 4}px`;
+    menu.style.left = `${rect.right + window.scrollX - menu.offsetWidth}px`;
+  });
+
+  const handleOutside = (e) => {
+    if (!menu.contains(e.target)) {
+      closeSuccessorMenu();
+    }
+  };
+  setTimeout(() => document.addEventListener('mousedown', handleOutside, { once: true }), 0);
+  activeMenu = { menu, handleOutside };
+}
+
+function closeSuccessorMenu() {
+  if (activeMenu) {
+    activeMenu.menu.remove();
+    document.removeEventListener('mousedown', activeMenu.handleOutside, { once: true });
+    activeMenu = null;
+  }
